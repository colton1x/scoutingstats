# Optional API keys for live external integrations when deploying to Streamlit Community Cloud.
# Copy these keys into your Streamlit App Dashboard -> Settings -> Secrets.
# None of these are required: the app runs out-of-the-box using bundled datasets + the public keyless FPL API.

# Optional: Live match scores & fixtures from https://www.football-data.org/client/register (Free tier: 10 req/min)
# FOOTBALL_DATA_API_KEY = "your_free_football_data_org_token"

# Optional: Persistent cloud watchlists, assignments & scouting notes via https://supabase.com (Free tier)
# SUPABASE_URL = "https://your-project.supabase.co"
# SUPABASE_KEY = "your-supabase-anon-key"
